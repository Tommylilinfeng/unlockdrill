# Copy to .env and fill in. All optional: the app runs without them (signup falls back to local storage, analytics stays off).
VITE_EXAM=sat                 # sat | gre  (which question bank and copy variant to load)
VITE_SITE_URL=https://unlockdrill.pages.dev
VITE_GA_ID=                   # G-XXXXXXXXXX from analytics.google.com
VITE_SUPABASE_URL=            # https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=       # anon public key (safe for browser; RLS limits it to inserts)
